# Production Dockerfile for GrowX FastAPI Engine
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=off \
    GROWX_ENV=production

WORKDIR /app

# Install system runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY pyproject.toml .
RUN pip install --upgrade pip && \
    pip install .

# Copy application source
COPY src/ /app/src/
COPY data/ /app/data/

# Create non-root runtime user
RUN useradd -m -u 1001 growx && \
    chown -R growx:growx /app

USER growx

EXPOSE 7411

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:7411/health/live || exit 1

CMD ["python", "-m", "uvicorn", "growx_crawl.web.app:app", "--host", "0.0.0.0", "--port", "7411", "--workers", "4"]
