# Dedicated Worker Container for GrowX
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    GROWX_ENV=production

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --upgrade pip && \
    pip install .

# Optional playwright install for browser worker
RUN pip install playwright && playwright install --with-deps chromium || true

COPY src/ /app/src/
COPY data/ /app/data/

RUN useradd -m -u 1001 growx && \
    chown -R growx:growx /app

USER growx

# WORKER_TYPE passed at container run time
ENV WORKER_MODULE=growx_crawl.workers.crawler

CMD python -m $WORKER_MODULE
