# GrowX Crawl Environment Configuration

# Database
GROWX_CRAWL_DB_PATH=growx_crawl.db
GROWX_STORAGE_BACKEND=sqlite

# Turso / LibSQL Database (Optional)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
GROWX_CRAWL_TURSO_URL=
LIBSQL_URL=

# Crawler defaults
GROWX_CRAWL_WORKERS=10
GROWX_CRAWL_MAX_DEPTH=2
GROWX_CRAWL_MAX_PAGES_PER_DOMAIN=10
GROWX_CRAWL_TIMEOUT_SECONDS=15
GROWX_CRAWL_REQUESTS_PER_SECOND=2
GROWX_CRAWL_USER_AGENT=GrowXCrawl/1.0 (+https://growxlabs.tech/bot)

# Discovery Provider Secrets (Optional)
MAPS_API_KEY=
SEARCH_API_KEY=

# GrowXLabs Remote Integration Secrets (Optional)
GROWXLABS_API_BASE_URL=https://api.growxlabs.tech
GROWXLABS_INGESTION_TOKEN=

# Scoring Profile
GROWX_CRAWL_SCORING_PROFILE=jewellery

# ── CAPTCHA Solver API Keys ──────────────────────────────────────────────────
# CapSolver (recommended — faster & cheaper): https://capsolver.com
CAPSOLVER_API_KEY=
# 2Captcha (fallback): https://2captcha.com
TWOCAPTCHA_API_KEY=

# ── Proxy Configuration ─────────────────────────────────────────────────────
# Single proxy URL
PROXY_URL=
# Comma-separated proxy lists per tier (auto-escalation: Direct → DC → Residential → Mobile)
DATACENTER_PROXIES=
RESIDENTIAL_PROXIES=
MOBILE_PROXIES=
